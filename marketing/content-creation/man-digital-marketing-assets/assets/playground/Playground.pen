                  "justifyContent": "center",
                  "children": [
                    {
                      "type": "text",
                      "id": "LDOjH",
                      "name": "We set baseline data points like conversion, time and volume metrics, so processes are measured against standardised model.",
                      "fill": "#2D2D2D",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "\"Most teams buy more software hoping it fixes broken processes. But alignment is a people and process problem — no tool can solve that for you.\"",
                      "lineHeight": 1.4,
                      "fontFamily": "Montserrat",
                      "fontSize": 36,
                      "fontWeight": "normal",
                      "fontStyle": "italic"
