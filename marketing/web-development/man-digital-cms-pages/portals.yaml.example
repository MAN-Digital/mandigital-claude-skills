# Which portal to deploy to + how. deploy.sh reads this file live.
# Copy this file to portals.yaml (same folder, gitignored) and edit values.
# NEVER put tokens/keys in this file -- each entry names its token's env var
# (tokenEnv); the secret itself lives in your shell env, e.g.:
#   export HS_TOKEN_STAGING='pat-...'   # staging portal's private-app token
#   export HS_TOKEN_PROD='pat-...'      # prod portal's private-app token
# Precedence per deploy: --token flag > tokenEnv var > HS_TOKEN > hidden prompt.
portals:
  # --- staging entry (safe playground) ---
  - id: staging            # short name YOU pick; used as: deploy.sh --portal staging
    portalId: 146425426    # HubSpot portal ID (numbers only, no quotes needed)
    hsAccount: man-digital-development  # name from `hs account list` (PAK auth, must exist first)
    theme: dryrun-test     # destination theme FOLDER in Design Manager (created if missing)
    staging: true          # exactly ONE entry must be true (gate-5 staging checks use it)
    blogId: null           # HubSpot blog id, or null to auto-provision one
    domain: null           # public domain, or null (informational only)
    forms: {}              # module-name -> HubSpot form GUID map (empty = no forms yet)
    tokenEnv: HS_TOKEN_STAGING  # env var holding THIS portal's token (omit this key = shared HS_TOKEN/prompt; a NAMED-but-unset var fails the run, never falls back)
    # formsProvision: {}   # OPTIONAL (absent = manual forms, old behavior). When enabled,
                           # deploy.sh runs create-forms.sh BEFORE the theme upload (plan step 2b):
    # formsProvision:
    #   enabled: true        # gate flag; false/absent = provisioning skipped entirely
    #   spec: forms/staging.json  # form-spec JSON (relative to THIS file, or absolute)
    #   prefix: "[staging] "     # optional HubSpot-side name prefix (lets staging/prod coexist)

  # --- production entry (real site) ---
  - id: prod                      # deploy.sh --portal prod
    portalId: 22222222             # <-- REPLACE with your real portal ID
    hsAccount: prod                # <-- REPLACE with your `hs account list` name for that portal
    theme: my-theme                # <-- REPLACE with the theme folder to create/update
    staging: false                 # must stay false here (only staging is true)
    blogId: 123456789              # <-- REPLACE with real blog id, or null to provision
    domain: www.example.com        # <-- REPLACE with real domain, or null
    forms:                         # one line per form module in the theme:
      enquiry_form: "00000000-0000-0000-0000-000000000000"  # <-- REPLACE with real form GUID
    tokenEnv: HS_TOKEN_PROD      # <-- env var holding THIS portal's token
