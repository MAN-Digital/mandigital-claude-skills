#!/usr/bin/env python3
from __future__ import annotations

import argparse
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))

from scripts.maintenance.sync import SyncError, sync_checkout


def main() -> int:
    parser = argparse.ArgumentParser(description="Safely synchronize a MAN Digital skills checkout.")
    parser.add_argument("--repo", type=Path, required=True)
    parser.add_argument("--state-dir", type=Path, default=Path.home() / ".local/state/man-digital-skills")
    parser.add_argument("--install-root", type=Path, action="append", default=[])
    arguments = parser.parse_args()
    try:
        result = sync_checkout(arguments.repo, arguments.state_dir, arguments.install_root)
    except SyncError as error:
        print(f"FAIL: {error}", file=sys.stderr)
        return 1
    print(f"PASS: {result.message} ({result.commit[:12]})")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
