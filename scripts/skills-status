#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))

from scripts.maintenance.status import collect_status


def main() -> int:
    parser = argparse.ArgumentParser(description="Report MAN Digital skill maintenance status.")
    parser.add_argument("--repo", type=Path, required=True)
    parser.add_argument("--state-dir", type=Path, default=Path.home() / ".local/state/man-digital-skills")
    parser.add_argument("--install-root", type=Path, action="append", default=[])
    parser.add_argument("--json", action="store_true", dest="as_json")
    arguments = parser.parse_args()
    payload = collect_status(arguments.repo, arguments.state_dir, arguments.install_root)
    if arguments.as_json:
        print(json.dumps(payload, indent=2, sort_keys=True))
    else:
        print(
            f"{payload['machine']}: {payload['branch']} {str(payload['commit'])[:12]} "
            f"dirty={payload['dirty']} behind={payload['behind']}"
        )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
