#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))

from scripts.maintenance.doctor import validate_repository


def main() -> int:
    parser = argparse.ArgumentParser(description="Validate the MAN Digital shared skill repository.")
    parser.add_argument("--repo", type=Path, default=Path.cwd())
    parser.add_argument("--quick", action="store_true")
    parser.add_argument("--bootstrap-cms", action="store_true")
    parser.add_argument("--json", action="store_true", dest="as_json")
    arguments = parser.parse_args()

    report = validate_repository(
        arguments.repo,
        quick=arguments.quick,
        bootstrap_cms=arguments.bootstrap_cms,
    )
    if arguments.as_json:
        print(json.dumps(report.to_dict(), indent=2, sort_keys=True))
    else:
        print(report.render())
    return 0 if report.ok else 1


if __name__ == "__main__":
    raise SystemExit(main())
