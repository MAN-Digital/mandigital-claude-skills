#!/usr/bin/env bash
# Fake curl for cms-pages tests: no network, canned JSON per HTTP method.
# FAKE_CURL_FAIL=1 -> exit 22 like a real auth failure.
# FAKE_CURL_GET_RESP / FAKE_CURL_POST_RESP / FAKE_CURL_PUT_RESP override bodies.
# FAKE_CURL_LOG=<file> appends one line per call: "<METHOD> <url> [@data-body]".
if [ "${FAKE_CURL_FAIL:-0}" = "1" ]; then echo '{"error":"bad-token"}' >&2; exit 22; fi
method=GET
url=""
data=""
prev=""
for a in "$@"; do
  case "$prev" in
    -X) method="$a" ;;
    -d|--data) case "$a" in @*) [ -f "${a#@}" ] && data=$(cat "${a#@}") ;; *) data="$a" ;; esac ;;
    *) case "$a" in http*|/marketing/*|/files/*|/cms/*) url="$a" ;; esac ;;
  esac
  prev="$a"
done
if [ -n "${FAKE_CURL_LOG:-}" ]; then
  if [ -n "$data" ]; then printf '%s %s %s\n' "$method" "$url" "$data" >> "$FAKE_CURL_LOG";
  else printf '%s %s\n' "$method" "$url" >> "$FAKE_CURL_LOG"; fi
fi
# NOTE: defaults live in variables because a JSON literal inside ${VAR:-...}
# would terminate the expansion at its first } and leak a literal brace.
default_get='{"results": []}'
default_post='{"id": "11111111-1111-1111-1111-111111111111"}'
default_put='{"id": "22222222-2222-2222-2222-222222222222"}'
case "$method" in
  POST) printf '%s\n' "${FAKE_CURL_POST_RESP:-$default_post}" ;;
  PUT) printf '%s\n' "${FAKE_CURL_PUT_RESP:-$default_put}" ;;
  *) printf '%s\n' "${FAKE_CURL_GET_RESP:-$default_get}" ;;
esac
exit 0
